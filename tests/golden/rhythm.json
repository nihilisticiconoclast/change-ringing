  "headings": [
    {
      "level": "h1",
      "text": "Ringing has a pulse#It also has a memory."
    },
    {
      "level": "h2",
      "text": "The only part that is actually a rhythm"
    },
    {
      "level": "h3",
      "text": "Does it hold every year?"
    },
    {
      "level": "h2",
      "text": "Every day of four years"
    },
    {
      "level": "h2",
      "text": "Twenty-four days, a fifth of the ringing"
    },
    {
      "level": "h2",
      "text": "You can tell what happened from what was rung"
    },
    {
      "level": "h2",
      "text": "\u201c# Tolling\u201d"
    },
    {
      "level": "h2",
      "text": "Remembrance Sunday, four years running"
    },
    {
      "level": "h2",
      "text": "September is not the busiest month"
    },
    {
      "level": "h3",
      "text": "What this repository previously recorded"
    }
  ],
